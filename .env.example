# Copy to .env for local development. Never commit real credentials.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app?schema=public"

# Dedicated integration database. The test harness rejects URLs whose database
# name is not explicitly test-only and never falls back to DATABASE_URL.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/dietyaar_test?schema=public"

# Required before Better Auth is enabled. Generate at least 32 random characters.
BETTER_AUTH_SECRET="replace-with-a-random-secret-before-auth-work"
BETTER_AUTH_URL="http://localhost:3000"

LOG_LEVEL=info
PRISMA_LOG_QUERIES=false

# Optional provider features remain disabled until configured and consent-gated.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=
# AI_PROVIDER_API_KEY=
