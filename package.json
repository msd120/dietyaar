{
  "name": "dietyaar",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": "11.19.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "esbuild src/worker/run.ts --bundle --platform=node --format=cjs --outfile=.next/worker.cjs --external:@prisma/client --external:.prisma/client --external:pino --alias:server-only=./src/worker/server-only-shim.ts",
    "start": "next start",
    "worker": "tsx src/worker/run.ts",
    "lint": "eslint",
    "lint:rtl": "node scripts/rtl-smoke-check.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:all": "npm run lint && npm run lint:rtl && npm run typecheck && npm run format:check",
    "test": "vitest run",
    "test:compat": "prisma generate --schema src/__tests__/compatibility/fixtures/better-auth.prisma && tsc -p src/__tests__/compatibility/tsconfig.json --noEmit && vitest run --config src/__tests__/compatibility/vitest.config.mts",
    "test:integration": "node scripts/run-db-integration-tests.mjs",
    "test:supabase": "node scripts/test-supabase-connections.mjs",
    "demo:seed": "tsx scripts/seed-demo-user.ts",
    "nutrition:seed:fixture": "tsx scripts/seed-nutrition-fixture.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "db:up": "docker compose up -d db",
    "db:test:up": "docker compose --profile test up -d db-test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "deps:update": "npx npm-check-updates -u --target minor && npm install",
    "deps:update:major": "npx npm-check-updates -i",
    "reinstall": "rm -rf node_modules package-lock.json && npm install"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-direction": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/supabase-js": "^2.119.0",
    "better-auth": "1.7.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-jalali": "^4.4.0-0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.46.0",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "pino": "^10.3.1",
    "react": "19.3.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.0",
    "ajv": "^8.17.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^17.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.6.2",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.0",
    "vitest-mock-extended": "^4.0.0"
  }
}
